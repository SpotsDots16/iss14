<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client.Xenoarchaeology.Ui.PeerReviewConsoleWindow"
    Title="Peer Review Console"
    MinSize="380 240">

    <BoxContainer
        Orientation="Vertical"
        SeparationOverride="8"
        Margin="8">

        <Label
            Name="StoredValueLabel"
            Text="Stored research data: 0"
            HorizontalAlignment="Center" />

        <Label
            Text="Compile submitted artifact findings into research publications."
            HorizontalAlignment="Center" />

        <Button
            Name="PublishSmallButton"
            Text="Publish minor findings — 1,000 points (4 data)"
            HorizontalExpand="True" />

        <Button
            Name="PublishMediumButton"
            Text="Publish significant findings — 5,000 points (8 data)"
            HorizontalExpand="True" />

        <Button
            Name="PublishLargeButton"
            Text="Publish major findings — 10,000 points (16 data)"
            HorizontalExpand="True" />

    </BoxContainer>
</DefaultWindow>

